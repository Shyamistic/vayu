# ── Environment ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://vayu:vayu_dev@localhost:5432/vayu_climate

# Redis
REDIS_URL=redis://localhost:6379

# Model
MODEL_PATH=./checkpoints/vayu_best.pt
MODEL_VERSION=1.0.0

# API Keys (get from respective consoles)
CESIUM_ION_TOKEN=your_cesium_ion_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Data sources
IMD_DATA_DIR=./data/imd
MOSDAC_DATA_DIR=./data/mosdac
PROCESSED_DATA_DIR=./data/processed

# MOSDAC credentials (register at mosdac.gov.in)
MOSDAC_USERNAME=your_username
MOSDAC_PASSWORD=your_password

# AWS (optional, for S3 storage and SageMaker training)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=vayu-climate-data

# Backend
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://vayu-climate.vercel.app
MAX_CONCURRENT_USERS=10

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
