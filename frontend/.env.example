# VAYU Frontend Environment Variables
# Copy this file to .env.local and fill in your tokens

# ── Cesium Ion (REQUIRED for world terrain + Bing imagery) ──────────────────
# Sign up free: https://cesium.com/ion/signup
# After login: Access Token → "My Tokens" → copy the default token
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# ── Backend API URL ──────────────────────────────────────────────────────────
# Leave blank to use the same origin (works for Vercel/Railway deployments)
# Set to e.g. https://api.vayu.yourdomain.com for separate backend
VITE_API_URL=

# ── Optional: OpenWeatherMap (free tier: 1000 calls/day) ─────────────────────
# Used for real-time weather overlay tiles
# Sign up: https://openweathermap.org/api
VITE_OPENWEATHERMAP_KEY=

# ── Optional: Google Maps API key for 3D Tiles ───────────────────────────────
# Required only for Google Photorealistic 3D Tiles (city buildings)
# https://developers.google.com/maps/documentation/tile
VITE_GOOGLE_MAPS_API_KEY=

# ── NOTE: NASA GIBS (MODIS, IMERG, Cloud Cover) requires NO API key ──────────
# These satellite layers are completely free and open to the public.
# Docs: https://nasa.github.io/gibs/
