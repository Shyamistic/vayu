{
  "name": "MAUSAM Climate Digital Twin",
  "short_name": "MAUSAM",
  "description": "AI-powered climate forecasts and geospatial analysis for India.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
